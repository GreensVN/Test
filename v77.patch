+    version_info để test mô phỏng được mọi bản.
+    """
+    rows = diagnostic.check_runtime((3, 14, 0))
+    assert any(mark.strip() == "[!]" and "3.14" in text for mark, text in rows), rows
+    assert not any(mark.strip() == "[X]" for mark, _ in rows)
