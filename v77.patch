+    matrix = [tuple(int(x) for x in v.split(".")) for v in re.findall(r"(\d+\.\d+)", m.group(1))]
+    assert matrix, "khong doc duoc python-version ma tran trong ci.yml"
+    low, _ = _requires_python()
