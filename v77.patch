+def _result(**kwargs) -> dict:
+    """Kết quả parse_time_expression - LUÔN đủ khoá (v6) với giá trị mặc định 0."""
+    base = {"type": None, "minutes": 0, "hour": 0, "minute": 0, "day_offset": 0}
+    base.update(kwargs)
+    return base
+
