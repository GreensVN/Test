+    shim, _ = _shim()
+    fn = lambda: (_ for _ in ()).throw(ValueError("nope"))  # noqa: E731
+    info = shim.raises(ValueError, fn, match=r"^no")
+    assert info is not None and info.match(r"^no") is True
